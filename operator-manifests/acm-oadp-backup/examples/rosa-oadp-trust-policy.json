{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::REPLACE_ME_AWS_ACCOUNT_ID:oidc-provider/REPLACE_ME_OIDC_ENDPOINT"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "REPLACE_ME_OIDC_ENDPOINT:sub": [
            "system:serviceaccount:open-cluster-management-backup:openshift-adp-controller-manager",
            "system:serviceaccount:open-cluster-management-backup:velero"
          ]
        }
      }
    }
  ]
}
