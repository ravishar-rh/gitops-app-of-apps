cluster_name  = "my-rosa-cluster"
aws_region    = "us-east-1"
oidc_endpoint = "rh-oidc.s3.us-east-1.amazonaws.com/abc123xyz"

# Optional overrides
# s3_bucket_name              = "custom-bucket-name"
# s3_bucket_prefix            = "acm-backup"
# backup_schedule             = "0 */6 * * *"
# backup_ttl                  = "720h"
# secrets_manager_secret_name = "oadp/acm-backup-credentials"
# oadp_channel                = "stable-1.4"
# enable_cluster_backup       = true
# kubeconfig_path             = "~/.kube/config"
# tags                        = { "environment" = "production" }

# Disaster Recovery (only set during restore)
# restore_enabled     = true
# restore_type        = "full"       # "full" or "passive"
# restore_backup_name = "latest"     # or a specific backup name
